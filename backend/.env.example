# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste_your_key_here

# Required to use the /admin console. Any string; the console asks for it once.
# Leave unset and the admin API returns 503 -- the chat side still works.
ADMIN_TOKEN=change-me

# Postgres. The catalog, its chunks and their vectors all live here (pgvector).
DATABASE_URL=postgres://bacancy:devpass@localhost:5432/cookbot

# Optional overrides
PORT=4000
CORS_ORIGIN=http://localhost:3100
CHAT_MODEL=gemini-3.6-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768

# Retrieval tuning
# MIN_SCORE is the relevance floor -- below it a query returns no recipes at
# all, so "what is the capital of Peru" gets an honest "I can't help with
# that" instead of six unrelated recommendations. Re-calibrate if you change
# embed model.
RETRIEVE_K=12
# How many of the RETRIEVE_K candidates survive the ingredient-overlap
# rerank and get pasted into the prompt.
RERANK_TOP_K=6
MIN_SCORE=0.58

# Set to false to skip the query-rewrite call (1 chat call per turn instead of
# 2). Follow-ups like "make it vegetarian instead" get less accurate
# retrieval when off.
ENABLE_QUERY_REWRITE=true
